# =====================================================================
#  Rackbook – Konfiguration
#  Diese Datei wird von docker-compose.yml gelesen. Nach Änderungen:
#    docker compose up -d
#  Hinweis: Hier stehen standardmäßig KEINE Geheimnisse. Wenn du
#  APP_SECRET setzt, diese Datei nicht mehr öffentlich committen.
# =====================================================================

# ---------- Compose / Container ----------
# Image-Tag (latest, oder eine feste Version wie 1.0.0)
RACKBOOK_VERSION=latest
# Port auf dem Host und Bind-Adresse (127.0.0.1 = nur lokal, z. B. hinter Reverse Proxy)
RACKBOOK_PORT=3000
RACKBOOK_BIND=0.0.0.0
RACKBOOK_MEM_LIMIT=512m
# Zeitzone für Logs
TZ=Europe/Berlin

# ---------- Allgemein ----------
APP_NAME=Rackbook
# Öffentliche URL (z. B. https://docs.example.de). Wenn gesetzt, wird die
# Origin jeder schreibenden Anfrage strikt dagegen geprüft (CSRF-Schutz).
PUBLIC_URL=

# ---------- Reverse Proxy & Cookies ----------
# Anzahl vertrauenswürdiger Proxys vor Rackbook (0/false = direkter Zugriff,
# 1 = ein Proxy wie Traefik/Caddy/nginx). Nötig für korrekte Client-IPs
# (Rate-Limiting, Audit-Log) und für die HTTPS-Erkennung.
TRUST_PROXY=false
# Secure-Flag für das Sitzungs-Cookie: auto (= bei HTTPS), true oder false.
# Hinter einem TLS-Proxy mit TRUST_PROXY=1 funktioniert "auto" automatisch.
COOKIE_SECURE=auto

# ---------- Sicherheit ----------
# Schlüssel (mind. 32 Zeichen) zur Verschlüsselung der 2FA-Secrets.
# Leer = wird beim ersten Start zufällig erzeugt und im Volume gespeichert.
# Erzeugen z. B. mit: openssl rand -base64 48
APP_SECRET=
# Sitzung läuft nach so vielen Minuten Inaktivität ab
SESSION_IDLE_MINUTES=720
# Maximale Lebensdauer einer Sitzung in Tagen
SESSION_MAX_DAYS=14
# Fehlversuche bis zur Kontosperre und Sperrdauer in Minuten
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Max. Anmelde-/Registrierungsanfragen pro IP und Zeitfenster
RATE_LIMIT_AUTH=20
RATE_LIMIT_WINDOW_MINUTES=15
# Minimale Passwortlänge (mind. 8)
PASSWORD_MIN_LENGTH=10

# ---------- Single Sign-On (OIDC) ----------
# Die SSO-Konfiguration erfolgt komplett in der Oberfläche (Verwaltung → Single Sign-On).
# Nur falls Authentik ein Zertifikat einer eigenen CA nutzt: CA-Datei per Volume
# einbinden (z. B. ./ca.crt:/certs/ca.crt:ro) und hier den Pfad setzen.
NODE_EXTRA_CA_CERTS=

# ---------- Registrierung ----------
# Der ERSTE registrierte Benutzer wird immer Administrator.
# Danach (Standardwerte, später in der Verwaltung änderbar):
ALLOW_REGISTRATION=false
REGISTRATION_REQUIRES_APPROVAL=true
# Rolle für neu registrierte Benutzer: viewer oder editor
DEFAULT_ROLE=viewer

# ---------- Dokumente ----------
# Tage ohne Änderung, nach denen ein Dokument als "zu prüfen" gilt
STALE_DAYS=90
# Aufbewahrung im Papierkorb (Tage)
TRASH_RETENTION_DAYS=30
# Gespeicherte Versionen pro Dokument
REVISION_LIMIT=50
# Max. Größe eines Dokuments in KB
MAX_DOC_KB=1024
# Aufbewahrung des Audit-Logs (Tage)
AUDIT_RETENTION_DAYS=365
# Beim allerersten Start Beispieldokumente anlegen (true/false)
SEED_SAMPLE_DOCS=false

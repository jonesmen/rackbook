{
  "name": "rackbook",
  "version": "1.0.0",
  "private": true,
  "description": "Rackbook – selbstgehostete Markdown-Dokumentation für Homelab & IT-Infrastruktur",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/vendor.js",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "npm run build && DATA_DIR=./data COOKIE_SECURE=false node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "openid-client": "^6.8.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "esbuild": "^0.28.2",
    "htm": "^3.1.1",
    "katex": "^0.19.0",
    "material-symbols": "^0.47.6",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
